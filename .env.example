# ===== 服务鉴权（清小搭广场接入凭证，Bearer Token）=====
# 广场接入向导里填的 credential 就是这个值；留空则关闭鉴权（无需凭证，仅建议本地/内网调试）
API_KEY=sk-tsinghua-minor-dev

# ===== 上游大模型（OpenAI 兼容）=====
# 上游 LLM 的 API Key（如 DeepSeek / 智谱 / OpenAI 等兼容端点）
LLM_API_KEY=sk-tsinghua-minor-dev
# 上游 LLM 的 base_url，注意填到版本段为止，如 https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 上游模型名
LLM_MODEL=deepseek-v4-flash
# 对外暴露的模型名（/v1/models 与响应 model 字段）；不暴露上游模型名
MODEL_NAME=tsinghua-minor-advisor
# 单次上游调用超时（秒）
LLM_TIMEOUT=60
# 是否请求上游返回 usage（部分上游不支持时置 0）
LLM_INCLUDE_USAGE=1
# 采样温度（辅修顾问建议偏保守，0.2~0.4）
LLM_TEMPERATURE=0.3
# 单轮上游输出的最大 token 数（ReAct 每步一次调用）
LLM_MAX_TOKENS=2048

# ===== ReAct 循环 =====
# 最大思考-行动轮数（Thought→Action→Observation 计数）
MAX_REACT_STEPS=6
# 工具返回结果喂给模型的最大字符数（超长截断）
TOOL_RESULT_MAX_CHARS=6000

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
# 知识库目录（默认指向仓库内 minors/）
KNOWLEDGE_DIR=minors
